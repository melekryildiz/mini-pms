# Auth.js cookie şifreleme anahtarı. Üretimde uzun ve rastgele olmalıdır.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Auth.js'in bağlanacağı Keycloak OIDC client bilgileri.
AUTH_KEYCLOAK_ID=mini-pms-web
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=http://localhost:8081/realms/mini-pms

# Yalnızca Next.js sunucusunun eriştiği NestJS API Gateway adresi.
API_GATEWAY_URL=http://localhost:3001/api
