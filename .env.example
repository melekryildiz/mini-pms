
POSTGRES_USER=mini_pms
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mini_pms

# Yerel uygulama portları. Next.js 3000, API Gateway 3001 kullanır.
# Unit Service HTTP + RabbitMQ hibritidir; Gateway onu RabbitMQ'dan çağırır.
API_GATEWAY_PORT=3001
UNIT_SERVICE_PORT=3003
INGESTION_SERVICE_PORT=3004
CALCULATION_SERVICE_PORT=3005
ALARM_SERVICE_PORT=3006
REPORT_SERVICE_PORT=3007

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change_me
KEYCLOAK_DB_NAME=keycloak

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me

RABBITMQ_USER=mini_pms
RABBITMQ_PASSWORD=change_me

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me

# Unit Service altyapı bağlantıları.
# Uygulama host makinede çalışıyorsa aşağıdaki local adresler kullanılır.
# Uygulama Docker ağına alınırsa host değerleri redis ve neo4j yapılabilir.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
